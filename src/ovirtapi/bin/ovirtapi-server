#!/bin/bash

# Path to Apache binary
APACHE_BIN=$(command -v apache2 || command -v httpd)

# Source apache2 environment variables if they exist
[ -f /etc/apache2/envvars ] && . /etc/apache2/envvars

# Where to store the PID
PID_FILE="/tmp/ovirtapi-server.pid"

# App path for passenger-config restart
APP_PATH="/var/www/ovirtapi-server"

# Function to check if process is running
is_running() {
  [ -f "$PID_FILE" ] && ps -p "$(cat "$PID_FILE")" > /dev/null 2>&1
}

case "$1" in
  start)
    if is_running; then
      echo "Apache is already running (PID $(cat "$PID_FILE"))"
    else
      echo "Starting Apache"
      "$APACHE_BIN" -DFOREGROUND &
      echo $! > "$PID_FILE"
      echo "Started Apache (PID $(cat "$PID_FILE"))"
    fi
    ;;

  stop)
    if is_running; then
      echo "Stopping Apache (PID $(cat "$PID_FILE"))"
      kill "$(cat "$PID_FILE")"
      rm -f "$PID_FILE"
    else
      echo "Apache is not running or PID file missing"
    fi
    ;;

  restart)
    echo "Restarting Sinatra app via Passenger..."
    passenger-config restart-app "$APP_PATH" --ignore-app-not-running
    ;;

  full-restart)
    echo "Restarting Apache (full)"
    if is_running; then
      kill "$(cat "$PID_FILE")"
      rm -f "$PID_FILE"
    fi
    "$APACHE_BIN" -f "$APACHE_CONF" &
    echo $! > "$PID_FILE"
    echo "Apache restarted (PID $(cat "$PID_FILE"))"
    ;;

  status)
    if is_running; then
      echo "Apache is running (PID $(cat "$PID_FILE"))"
    else
      echo "Apache is not running"
    fi
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|full-restart|status}"
    exit 1
    ;;
esac
