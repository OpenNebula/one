[Unit]
Description=Sinatra App via Passenger
After=network.target

[Service]
Type=forking
ExecStart=/usr/lib/one/ovirtapi-server start
ExecStop=/usr/lib/one/ovirtapi-server stop
ExecReload=/usr/lib/one/ovirtapi-server restart
PIDFile=/tmp/ovirtapi-server.pid
WorkingDirectory=/var/www/ovirtapi-server
User=root
Group=root

[Install]
WantedBy=multi-user.target