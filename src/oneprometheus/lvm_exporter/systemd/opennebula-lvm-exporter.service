[Unit]
Description=OpenNebula Prometheus LVM Exporter
After=network-online.target
Wants=network-online.target
StartLimitInterval=60
StartLimitBurst=3

[Service]
User=oneadmin
Group=oneadmin
Type=simple
Restart=on-failure
RestartSec=5

# Override the lvm command using sudo instead of running the whole exporter as root.
ExecStart=/usr/bin/lvm_exporter --command "sudo -n --preserve-env=LVM_SUPPRESS_SYSLOG /usr/sbin/lvm"

[Install]
WantedBy=multi-user.target
