require_relative '../lib/tm_action'
require_relative '../lib/datastore'
require_relative '../lib/purefa'

include TransferManager
include OpenNebula

arg_src  = ARGV[0]
arg_vmid = ARGV[1]
arg_dsid = ARGV[2]

delete = Action.new(:vm_id => arg_vmid, :action_name => 'delete')
src    = Action::Location.new(arg_src)
src_ds = Datastore.new_with_id(arg_dsid, delete.one)
src_vm = VirtualMachine.new_with_id(arg_vmid, delete.one)
src_vm.info!

rc = src_ds.info(true)
raise rc.message.to_s if OpenNebula.is_error?(rc)

ds_hash = src_ds.to_hash['DATASTORE']['TEMPLATE']

purefa_host    = ds_hash['PUREFA_HOST']
purefa_token   = ds_hash['PUREFA_API_TOKEN']
purefa_target  = ds_hash['PUREFA_TARGET']
purefa_version = ds_hash.key?('PUREFA_VERSION') ? ds_hash['PUREFA_VERSION'] : PureFA::DEFAULT_API_VERSION
purefa_suffix  = ds_hash.key?('PUREFA_SUFFIX') ? "_#{ds_hash['PUREFA_SUFFIX']}" : ''

purefa = PureFA.new(
    :host        => purefa_host,
    :target      => purefa_target,
    :api_token   => purefa_token,
    :api_version => purefa_version,
    :action      => delete
)

if src.disk?
    vol_name = "one_#{arg_vmid}_disk_#{src.disk_id}#{purefa_suffix}"
    DriverLogger.log_info "Deleting volume #{vol_name}"

    begin
        volume = purefa.get_volume(vol_name)
        cxn    = volume.get_connection(src.host)

        cxn.remove_connection(src.host, :force => true)
        cxn.delete
        volume.destroy
        volume.delete

        DriverLogger.log_info "Volume #{vol_name} deleted"
    rescue Net::HTTPError => e
        message = JSON.parse(e.response.body)['errors'].first['message']
        raise e unless message.start_with?('Volume does not exist')

        DriverLogger.log_info "Volume #{vol_name} not found"
    end
end

rc = delete.ssh(
    :cmds => "rm -rf #{src.path}",
    :host => src.host,
    :err_msg => "Could not delete #{src.path}"
)
DriverLogger.log_error rc.stderr if OpenNebula.is_error?(rc)

DriverLogger.log_info "Deleted #{src.path}"
