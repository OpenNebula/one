require_relative '../lib/tm_action'
require_relative '../lib/datastore'
require_relative '../lib/backup'
require_relative '../lib/purefa'

require 'rexml/document'
require 'json'

TransferManager::Datastore.load_env

host_loc = ARGV[0]
vm_id    = ARGV[1].to_i
img_id   = ARGV[2].to_i
inc_id   = ARGV[3].to_i
disk_id  = ARGV[4].to_i

rhost, rdir = host_loc.split(':')
disk_ids = disk_id == -1 ? [] : [disk_id]

restore = TransferManager::Action.new(:vm_id => vm_id, :action_name => 'restore')

image = OpenNebula::Image.new_with_id(img_id, restore.one)
image.info

backup_one_ds = OpenNebula::Datastore.new_with_id(image['DATASTORE_ID'], restore.one)
backup_tm_ds  = TransferManager::Datastore.new(:ds => backup_one_ds)

begin
    if restore.vm.has_elements?('/VM/USER_TEMPLATE/ERROR')
        restore.vm.delete_element('/VM/USER_TEMPLATE/ERROR')
    end
    xml_data = <<~EOS
        #{restore.vm.to_xml}
        #{image.to_xml}
    EOS

    ls_cmd = (inc_id == -1 ? 'ls' : "ls -i #{inc_id}")
    rc = backup_tm_ds.action(ls_cmd, xml_data)
    raise "Cannot list backups: #{rc.stderr.strip}" unless rc.code == 0

    OpenNebula::DriverLogger.log_info("Found backups: #{rc.stdout.strip}")

    backups = JSON.parse(rc.stdout)
    available_ids = backups.keys.map(&:to_i)
    disk_ids = available_ids if disk_id == -1

    OpenNebula::DriverLogger.log_info("restoring #{disk_ids.size} disk(s): #{disk_ids}")

    disk_ids.each do |id|
        raise "Backup #{id} not found" unless backups.key?(id.to_s)

        disk_path = "#{rdir}/disk.#{id}"
        url = backups[id.to_s]

        rc = restore.ssh(:host => rhost, :cmds => "mkdir -p #{rdir}/backup", :nostderr => false)
        raise "Cannot create backup directory: #{rc.stderr}" unless rc.code == 0

        OpenNebula::DriverLogger.log_info("Created backup directory: #{rdir}/backup")
        cmd = <<~EOS
            #{__dir__}/../../datastore/downloader.sh --nodecomp #{url} - | \
            ssh #{rhost} dd of=#{rdir}/backup/disk.#{id} bs=64k conv=sparse
        EOS

        rc = restore.ssh(:host => false, :cmds => cmd, :nostderr => false)
        raise "Download failed for backup of disk #{id}" unless rc.code == 0

        OpenNebula::DriverLogger.log_info("Downloaded backup of disk #{id}: #{cmd}")
        cmd = "qemu-img convert -m 4 -O raw #{rdir}/backup/disk.#{id} #{disk_path}"

        rc = restore.ssh(:host => rhost, :cmds => cmd, :nostderr => false)
        raise "Convert failed for backup of disk #{id}: #{rc.stderr}" unless rc.code == 0

        OpenNebula::DriverLogger.log_info("Ran convert: #{cmd}")
        cmd = "rm -f #{rdir}/backup/disk.#{id}"
        rc = restore.ssh(:host => rhost, :cmds => cmd, :nostderr => false)
        raise "Cleanup failed for backup of disk #{id}: #{rc.stderr}" unless rc.code == 0

        OpenNebula::DriverLogger.log_info("Restored backup of disk #{id}")
    end
rescue StandardError => e
    OpenNebula::DriverLogger.log_error(e.message)
    restore.ssh(:host => rhost, :cmds => "rm -rf #{rdir}/backup")
    exit 1
end

restore.ssh(:host => rhost, :cmds => "rm -rf #{rdir}/backup")
OpenNebula::DriverLogger.log_info('Restore completed')
exit 0
