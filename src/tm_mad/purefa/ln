require_relative '../lib/tm_action'
require_relative '../lib/datastore'
require_relative '../lib/purefa'

include TransferManager
include OpenNebula

arg_src   = ARGV[0]
arg_dst   = ARGV[1]
arg_vmid  = ARGV[2]
arg_dsid  = ARGV[3]

ln = Action.new(:vm_id => arg_vmid, :action_name => 'ln')

src = Action::Location.new(arg_src)
dst = Action::Location.new(arg_dst)

purefa_ds = Datastore.new_with_id(
    ln.disk_attribute(dst.disk_id, 'DATASTORE_ID').to_i, ln.one
)
rc = purefa_ds.info(true)
raise rc.message.to_s if OpenNebula.is_error?(rc)

ds_hash = purefa_ds.to_hash['DATASTORE']['TEMPLATE']

purefa_host    = ds_hash['PUREFA_HOST']
purefa_token   = ds_hash['PUREFA_API_TOKEN']
purefa_target  = ds_hash['PUREFA_TARGET']
purefa_version = ds_hash.key?('PUREFA_VERSION') ? ds_hash['PUREFA_VERSION'] : PureFA::DEFAULT_API_VERSION
purefa_suffix  = ds_hash.key?('PUREFA_SUFFIX') ? "_#{ds_hash['PUREFA_SUFFIX']}" : ''

purefa = PureFA.new(
    :host        => purefa_host,
    :target      => purefa_target,
    :api_token   => purefa_token,
    :api_version => purefa_version,
    :action      => ln
)

image_ds = Datastore.new_with_id(arg_dsid, ln.one)
image_ds.info

unless image_ds.to_hash['DATASTORE']['TEMPLATE']['PUREFA_HOST']
    raise 'Image datastore is not a PureFA datastore'
end

new_volume   = false
new_vol_name = "one_#{arg_vmid}_disk_#{dst.disk_id}#{purefa_suffix}"

source_image = Image.new_with_id(
    ln.disk_attribute(dst.disk_id, 'IMAGE_ID').to_i, ln.one
)
rc = source_image.info
raise rc.message.to_s if OpenNebula.is_error?(rc)

begin
    source_vol_name = source_image['SOURCE'] # one_123_456(_suffix?)
    if source_vol_name.empty? || source_vol_name == '-'
        source_vol_name = "one_#{arg_dsid}_#{source_image['ID']}#{purefa_suffix}"
    end
    source_volume = purefa.get_volume(source_vol_name)

    DriverLogger.log_info "Linking #{source_vol_name} to #{dst.path}"

    save     = ln.disk_attribute(dst.disk_id, 'SAVE').upcase     == 'YES'
    clone    = ln.disk_attribute(dst.disk_id, 'CLONE').upcase    == 'YES'
    readonly = ln.disk_attribute(dst.disk_id, 'READONLY').upcase == 'YES'

    if !save && !clone && readonly
        new_volume = source_volume.clone(new_vol_name)
        DriverLogger.log_info "Cloned volume to #{new_volume.name}"
    else
        source_volume.rename(new_vol_name)
        new_volume = source_volume
        DriverLogger.log_info "Renamed volume #{source_volume.name} to #{new_volume.name}"
    end
rescue StandardError => e
    DriverLogger.log_error "Error cloning #{src.path} to #{dst.path}: #{e.message}"
    DriverLogger.log_error e.backtrace.to_s
    exit 1
end

cxn = false
begin
    cxn = new_volume.create_connection(dst.host)
    DriverLogger.log_info "Created connection for volume #{new_volume.name}"

    if dst.host && dst.host != src.host
        host_device_path = cxn.setup_disk(:host => dst.host)

        if !host_device_path
            raise "Unable to find device #{host_device_path} on host #{dst.host}"
        end

        script = <<-EOS
            mkdir -p "$(dirname '#{dst.path}')" && \
            ln -sf '#{host_device_path}' '#{dst.path}'
        EOS

        rc = ln.ssh(
            :cmds => script,
            :host => dst.host,
            :err_msg => "creating symlink from #{host_device_path} to #{dst.path}"
        )

        if rc.code != 0
            raise "Failed to create symlink: #{rc.stderr}"
        end
    end
rescue StandardError => e
    DriverLogger.log_error "Error setting up disk connection: #{e.message}"
    DriverLogger.log_error e.backtrace.to_s
    cxn.delete         if cxn
    new_volume.destroy if new_volume
    new_volume.delete  if new_volume
    exit 1
end

exit 0
