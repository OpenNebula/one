require_relative '../lib/tm_action'
require_relative '../lib/datastore'
require_relative '../lib/purefa'

include TransferManager
include OpenNebula

size    = "#{ARGV[0]}M"
_fmt    = ARGV[1]
arg_dst = ARGV[2]
vm_id   = ARGV[3]
ds_id   = ARGV[4]

mkimage = Action.new(:vm_id => vm_id, :action_name => 'mkimage')

dst = Action::Location.new(arg_dst)

purefa_ds = Datastore.new_with_id(ds_id, mkimage.one)
rc = purefa_ds.info(true)
raise rc.message.to_s if OpenNebula.is_error?(rc)

TransferManager::Datastore.load_env

fs = mkimage.disk_attribute(dst.disk_id, 'FS')

unless fs.nil? || fs.strip.empty? || fs == '-' || ENV['SUPPORTED_FS'].split(',').include?(fs)
    raise 'Unsupported filesystem'
end

ds_hash = purefa_ds.to_hash['DATASTORE']['TEMPLATE']

purefa_host    = ds_hash['PUREFA_HOST']
purefa_token   = ds_hash['PUREFA_API_TOKEN']
purefa_target  = ds_hash['PUREFA_TARGET']
purefa_version = ds_hash.key?('PUREFA_VERSION') ? ds_hash['PUREFA_VERSION'] : PureFA::DEFAULT_API_VERSION
purefa_suffix  = ds_hash.key?('PUREFA_SUFFIX') ? "_#{ds_hash['PUREFA_SUFFIX']}" : ''

purefa = PureFA.new(
    :host        => purefa_host,
    :target      => purefa_target,
    :api_token   => purefa_token,
    :api_version => purefa_version,
    :action      => mkimage
)

DriverLogger.log_info "Creating image with size #{size}"

new_volume_name = "one_#{vm_id}_disk_#{dst.disk_id}#{purefa_suffix}"
new_volume      = purefa.create_volume(:name => new_volume_name, :size => size)
cxn             = new_volume.create_connection(dst.host)
device_path     = nil

begin
    DriverLogger.log_info "Created connection for volume #{new_volume.name}"

    device_path = cxn.setup_disk(:host => dst.host)
    DriverLogger.log_info "Setup device #{device_path} for volume #{new_volume.name}"

    if !fs.nil? && fs != '-' && !fs.strip.empty?
        fs_opts = ENV ? ENV.fetch("FS_OPTS_#{fs}", '') : ''

        rc = mkimage.ssh(
            :cmds => new_volume.mkfs_command(device_path, fs, fs_opts),
            :host => dst.host,
            :err_msg => "Creating filesystem #{fs} on #{device_path}",
            :nostderr => false
        )
        if rc.code != 0
            DriverLogger.log_error 'Error making filesystem ' \
                                   "#{fs} on #{device_path}: #{rc.stderr}"
            raise rc
        end
        DriverLogger.log_info "Created filesystem #{fs} on #{device_path}"
    end
rescue StandardError => e
    DriverLogger.log_error "Error creating filesystem: #{e.message}"
    DriverLogger.log_error e.backtrace.to_s
    cxn.delete if cxn
    new_volume.destroy
    new_volume.delete
    exit 1
end

script = <<-EOS
    mkdir -p "$(dirname '#{dst.path}')" && \
    ln -sf '#{device_path}' '#{dst.path}'
EOS

mkimage.ssh(
    :cmds => script,
    :host => dst.host,
    :err_msg => "creating symlink from #{device_path} to #{dst.path}"
)

DriverLogger.log_info "Created image and symlink #{dst.path} → #{device_path}"

exit 0
