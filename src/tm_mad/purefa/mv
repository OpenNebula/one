require_relative '../lib/tm_action'
require_relative '../lib/datastore'
require_relative '../lib/purefa'

require 'socket'

include TransferManager
include OpenNebula

# ARGUMENTS:
# hostA:system_ds/disk.i|hostB:system_ds/disk.i
# vm_id
# ds_id
# OR ---
# hostA:system_ds/|hostB:system_ds/
# vm_id
# ds_id

arg_src  = ARGV[0]
arg_dst  = ARGV[1]
arg_vmid = ARGV[2]
arg_dsid = ARGV[3]

src = TransferManager::Action::Location.new(arg_src)
dst = TransferManager::Action::Location.new(arg_dst)

if src.disk? && dst.disk?
    OpenNebula::DriverLogger.log_info "Skipping single disk movement for VM #{arg_vmid}"
    exit 0
end

s = Addrinfo.getaddrinfo(src.host, nil, :UNSPEC, :STREAM).select(&:ip?).map(&:ip_address).uniq
d = Addrinfo.getaddrinfo(dst.host, nil, :UNSPEC, :STREAM).select(&:ip?).map(&:ip_address).uniq
if !(s & d).empty?
    OpenNebula::DriverLogger.log_info 'Refusing to copy to same host'
    exit 0
end

mv = Action.new(:vm_id => arg_vmid, :action_name => 'mv')

vm = VirtualMachine.new_with_id(arg_vmid, mv.one)
rc = vm.info
raise rc.message.to_s if OpenNebula.is_error?(rc)

vm = vm.to_hash['VM']

hpool = HostPool.new(mv.one)
rc = hpool.info
raise rc.message.to_s if OpenNebula.is_error?(rc)

purefa_ds = Datastore.new_with_id(arg_dsid, mv.one)
rc = purefa_ds.info(true)
raise rc.message.to_s if OpenNebula.is_error?(rc)

ds_hash = purefa_ds.to_hash['DATASTORE']['TEMPLATE']

purefa_host    = ds_hash['PUREFA_HOST']
purefa_token   = ds_hash['PUREFA_API_TOKEN']
purefa_target  = ds_hash['PUREFA_TARGET']
purefa_version = ds_hash.key?('PUREFA_VERSION') ? ds_hash['PUREFA_VERSION'] : PureFA::DEFAULT_API_VERSION
purefa_suffix  = ds_hash.key?('PUREFA_SUFFIX') ? "_#{ds_hash['PUREFA_SUFFIX']}" : ''

purefa = PureFA.new(
    :host        => purefa_host,
    :target      => purefa_target,
    :api_token   => purefa_token,
    :api_version => purefa_version,
    :action      => mv
)

tar_ssh = <<~EOF
    set -e -o pipefail

    tar -C '#{src.dir}' \
      --sparse --exclude='disk.*' \
      -cf - '#{src.base}' |
      ssh -T -- '#{dst.host}' bash -lc '
          set -e -o pipefail;
          rm -rf "#{dst.path}";
          mkdir -p "#{dst.dir}";
          tar -C #{dst.dir} -xf -
      '
EOF

rc = mv.ssh(:host => src.host,
            :cmds => tar_ssh,
            :forward => true,
            :err_msg => 'Error copying disk directory to target host',
            :nostdout => false,
            :nostderr => false)

raise rc.message.to_s if OpenNebula.is_error?(rc)

vm_disks = vm['TEMPLATE']['DISK'].is_a?(Array) ? vm['TEMPLATE']['DISK'] : [vm['TEMPLATE']['DISK']]

vm_disks.each do |disk|
    disk_id = disk['DISK_ID']
    link_path = "/var/lib/one/datastores/#{arg_dsid}/#{arg_vmid}/disk.#{disk_id}"
    volume_name = "one_#{arg_vmid}_disk_#{disk_id}#{purefa_suffix}"

    volume = purefa.get_volume(volume_name)
    mv.ssh(
        :cmds => "test -L #{link_path} && unlink #{link_path}",
        :host => dst.host,
        :silent => true
    )

    cxn = volume.create_connection(dst.host)
    device_path = cxn.setup_disk(:host => dst.host)

    link_command = <<-EOS
        mkdir -p "$(dirname '#{link_path}')" && \
        ln -sf '#{device_path}' '#{link_path}'
    EOS

    mv.ssh(
        :cmds => link_command,
        :host => dst.host,
        :err_msg => "creating symlink from #{device_path} to #{link_path}"
    )
    DriverLogger.log_info "Symlink created from #{device_path} to #{link_path}"
end

DriverLogger.log_info "Setup disks on #{dst.host} for VM #{arg_vmid}"

vm_disks.each do |disk|
    disk_id = disk['DISK_ID']
    link_path = "/var/lib/one/datastores/#{arg_dsid}/#{arg_vmid}/disk.#{disk_id}"
    volume_name = "one_#{arg_vmid}_disk_#{disk_id}#{purefa_suffix}"

    volume = purefa.get_volume(volume_name)
    cxn = volume.get_connection(src.host)
    cxn.remove_connection(src.host, :force => true)

    del_command = "unlink #{link_path}"
    mv.ssh(
        :cmds => del_command,
        :host => src.host
    )
    DriverLogger.log_info "Removed symlink #{link_path} on #{src.host}"

    cxn.delete
end

del_command = "rm -rf /var/lib/one/datastores/#{arg_dsid}/#{arg_vmid}"
mv.ssh(
    :cmds => del_command,
    :host => src.host
)
DriverLogger.log_info 'Removed VM directory ' \
                      "/var/lib/one/datastores/#{arg_dsid}/#{arg_vmid} " \
                      "for VM #{arg_vmid} on #{src.host}"
