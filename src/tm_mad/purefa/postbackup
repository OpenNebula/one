require_relative '../lib/tm_action'
require_relative '../lib/datastore'

require 'fileutils'
require 'base64'

TransferManager::Datastore.load_env

_vm_xml    = STDIN.read
host_loc   = ARGV[0]
_disks_str = ARGV[1]
_deploy_id = ARGV[2]
_bjid      = ARGV[3]
vmid       = ARGV[4]
_dsid      = ARGV[5]

rhost, rdir = host_loc.split(':')
base_path   = ENV['BACKUP_BASE_PATH']

bck_dir = base_path ? "#{base_path}/#{vmid}/backup" : "#{rdir}/backup"

dirs_to_remove = [bck_dir]
dirs_to_remove << "#{base_path}/#{vmid}" if base_path

rm_script = "rm -rf #{bck_dir}"
rm_script << "; rm -rf #{base_path}/#{vmid}\n" if base_path

rc = TransferManager::Action.ssh(
    'postbackup',
    :host => rhost,
    :cmds => rm_script
)

if rc.code != 0
    OpenNebula::DriverLogger.log_error("Error cleaning backup files: #{rc.stdout} #{rc.stderr}")
    exit 1
end

OpenNebula::DriverLogger.log_info('postbackup: cleanup completed successfully')
exit 0
