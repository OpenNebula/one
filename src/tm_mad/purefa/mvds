require_relative '../lib/tm_action'
require_relative '../lib/datastore'
require_relative '../lib/purefa'

include TransferManager
include OpenNebula

arg_src   = ARGV[0]
arg_dst   = ARGV[1]
arg_vmid  = ARGV[2]
_arg_dsid = ARGV[3]

mvds = Action.new(:vm_id => arg_vmid, :action_name => 'mvds')

src = Action::Location.new(arg_src)
dst = Action::Location.new(arg_dst)

hpool = HostPool.new(mvds.one)
rc = hpool.info
raise rc.message.to_s if OpenNebula.is_error?(rc)

src_ds = Datastore.new_with_id(mvds.disk_attribute(src.disk_id, 'DATASTORE_ID').to_i, mvds.one)
rc = src_ds.info(true)
raise rc.message.to_s if OpenNebula.is_error?(rc)

ds_hash = src_ds.to_hash['DATASTORE']['TEMPLATE']

purefa_host    = ds_hash['PUREFA_HOST']
purefa_token   = ds_hash['PUREFA_API_TOKEN']
purefa_target  = ds_hash['PUREFA_TARGET']
purefa_version = ds_hash.key?('PUREFA_VERSION') ? ds_hash['PUREFA_VERSION'] : PureFA::DEFAULT_API_VERSION
purefa_suffix  = ds_hash.key?('PUREFA_SUFFIX') ? "_#{ds_hash['PUREFA_SUFFIX']}" : ''

purefa = PureFA.new(
    :host        => purefa_host,
    :target      => purefa_target,
    :api_token   => purefa_token,
    :api_version => purefa_version,
    :action      => mvds
)

DriverLogger.log_info "Moving #{src.path} to #{dst.path}"

source_vol_name = "one_#{arg_vmid}_disk_#{src.disk_id}#{purefa_suffix}"

if dst.path.empty? || dst.path.to_s == '-'
    new_vol_name = "one_#{arg_vmid}_disk_#{dst.disk_id}#{purefa_suffix}"
else
    new_vol_name = dst.path
end

volume = purefa.get_volume(source_vol_name)
cxn    = volume.get_connection(src.host)

DriverLogger.log_info "Found volume #{source_vol_name} and connection"
if cxn
    cxn.remove_connection(src.host, :force => true)
    cxn.delete
    DriverLogger.log_info "Removed connection for volume #{source_vol_name} from host #{src.host}"
else
    DriverLogger.log_error "Could not find connection for volume #{source_vol_name}"
end

volume.rename(new_vol_name)

DriverLogger.log_info "Renamed volume #{source_vol_name} to #{new_vol_name}"
