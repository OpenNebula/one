require_relative '../lib/tm_action'
require_relative '../lib/datastore'
require_relative '../lib/purefa'

include TransferManager
include OpenNebula

arg_src    = ARGV[0]
arg_dst    = ARGV[1]
arg_snapid = ARGV[2].to_i
arg_vmid   = ARGV[3].to_i
arg_dsid   = ARGV[4].to_i

cpds = Action.new(:vm_id => arg_vmid, :action_name => 'cpds')

src = Action::Location.new(arg_src)
dst_volume = arg_dst

purefa_ds = Datastore.new_with_id(
    cpds.disk_attribute(src.disk_id, 'DATASTORE_ID').to_i, cpds.one
)
rc = purefa_ds.info(true)
raise rc.message.to_s if OpenNebula.is_error?(rc)

ds_hash = purefa_ds.to_hash['DATASTORE']['TEMPLATE']

purefa_host    = ds_hash['PUREFA_HOST']
purefa_token   = ds_hash['PUREFA_API_TOKEN']
purefa_target  = ds_hash['PUREFA_TARGET']
purefa_version = ds_hash.key?('PUREFA_VERSION') ? ds_hash['PUREFA_VERSION'] : PureFA::DEFAULT_API_VERSION
purefa_suffix  = ds_hash.key?('PUREFA_SUFFIX') ? "_#{ds_hash['PUREFA_SUFFIX']}" : ''

purefa = PureFA.new(
    :host        => purefa_host,
    :target      => purefa_target,
    :api_token   => purefa_token,
    :api_version => purefa_version,
    :action      => cpds
)

image_ds = Datastore.new_with_id(arg_dsid, cpds.one)
rc = image_ds.info
raise rc.message if OpenNebula.is_error?(rc)

unless image_ds.to_hash['DATASTORE']['TEMPLATE']['PUREFA_HOST']
    raise 'Image datastore is not a PureFA datastore'
end

DriverLogger.log_info "Saving VM disk #{src.disk_id} to #{src.path}"

source_volume_name = "one_#{arg_vmid}_disk_#{src.disk_id}#{purefa_suffix}"
source_volume      = purefa.get_volume(source_volume_name)

if arg_snapid != -1
    snap          = source_volume.get_snapshot(arg_snapid)
    source_volume = snap
    DriverLogger.log_info "Using snapshot ID #{arg_snapid}"
end

new_volume = source_volume.clone(dst_volume)

DriverLogger.log_info "Created volume #{new_volume.name}"
