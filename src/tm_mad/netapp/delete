require_relative '../lib/tm_action'
require_relative '../lib/netapp'

include OpenNebula
include TransferManager

arg_src  = ARGV[0]
arg_vmid = ARGV[1]
arg_dsid = ARGV[2]

delete = Action.new(:vm_id => arg_vmid, :action_name => 'delete')
src    = Action::Location.new(arg_src)
src_ds = Datastore.new_with_id(arg_dsid, delete.one)
src_vm = VirtualMachine.new_with_id(arg_vmid, delete.one)
src_vm.info!

rc = src_ds.info(true)
raise rc.message.to_s if OpenNebula.is_error?(rc)

LOCK_DIR = '/var/lock/one/netapp'
FileUtils.mkdir_p(LOCK_DIR) unless File.directory?(LOCK_DIR)

def with_parent_lock(uuid)
    File.open(File.join(LOCK_DIR, "parent-#{uuid}.lock"), File::RDWR|File::CREAT, 0o644) do |f|
        DriverLogger.log_info "Locking file parent-#{uuid}.lock"
        f.flock(File::LOCK_EX)
        begin
            yield
        ensure
            f.flock(File::LOCK_UN)
            DriverLogger.log_info "Unlocked file parent-#{uuid}.lock"
        end
    end
end

begin
    ds_hash = src_ds.to_hash['DATASTORE']['TEMPLATE']

    host        = ds_hash['NETAPP_HOST']
    user        = ds_hash['NETAPP_USER']
    password    = ds_hash['NETAPP_PASS']
    target      = ds_hash['NETAPP_TARGET']

    netapp_suffix = ds_hash.key?('NETAPP_SUFFIX') ? "_#{ds_hash['NETAPP_SUFFIX']}" : ''

    if src.disk?
        auth     = Base64.strict_encode64("#{user}:#{password}")
        netapp   = NetApp.new(auth, host, target, :action => delete)

        vol_name = "one_#{arg_vmid}_disk_#{src.disk_id}#{netapp_suffix}"
        DriverLogger.log_info "Deleting volume #{vol_name}"
        img_vol = NetApp::Volume.new({ 'name' => vol_name }, netapp)
        # img_vol.fetch_data
        begin
            img_lun = img_vol.lun
            if img_lun && img_lun.lun_map
                DriverLogger.log_info "Unmapping LUN #{img_lun.name}"
                img_lun.lun_map.remove_connection(src.host, :force => true)
                img_lun.lun_map.delete
            end
            img_lun.delete
        rescue NetApp::API::Error => e
            if e.code == '404'
                DriverLogger.log_info "LUN #{img_vol.name}_lun " \
                                                 'missing or already deleted'
            else
                raise e
            end
        end
        DriverLogger.log_info "Deleted LUN #{img_vol.name}_lun"

        img_vol.fetch_data({ 'fields' => 'clone' })

        if img_vol.data['clone']['is_flexclone']
            DriverLogger.log_info "Volume #{img_vol.name} is a flexclone, checking parent"
            parent_uuid = img_vol.data['clone']['parent_volume']['uuid']
            with_parent_lock(parent_uuid) do
                parent_vol = NetApp::Volume.new({ 'uuid' => parent_uuid }, netapp)
                # parent_vol.fetch_data
                gs = parent_vol.get_snapshots.find {|s| s['name'] == NetApp::GOLDENSNAP_NAME }
                if !gs.nil?
                    all_clones = gs.clones
                    DriverLogger.log_info \
                        "Found #{all_clones.size} clones for parent volume #{parent_vol.name}."
                    if all_clones.size == 1 && all_clones[0].uuid == img_vol.uuid
                        img_vol.delete(:wait => true)
                        DriverLogger.log_info "Deleted volume #{img_vol.name} uuid #{img_vol.uuid}"
                        all_clones = gs.clones
                        # Tiny issue when you're recreating from the same disk over and over
                        # the golden snapshot is used again between previous check and this delete
                        gs.delete if all_clones.size == 1 && all_clones[0].uuid == img_vol.uuid
                        DriverLogger.log_info \
                            "Deleted goldensnap from parent volume #{parent_vol.name}"
                    else
                        img_vol.delete
                        DriverLogger.log_info "Deleted volume #{img_vol.name} uuid #{img_vol.uuid}"
                    end
                else
                    img_vol.delete
                    DriverLogger.log_info "Deleted volume #{img_vol.name} uuid #{img_vol.uuid}"
                end
            end
        else
            img_vol.delete
            DriverLogger.log_info "Deleted volume #{img_vol.name} uuid #{img_vol.uuid}"
        end
    end

    # Delete VM disk or directory
    rc = delete.ssh(
        :cmds => "rm -rf #{src.path}",
        :host => src.host,
        :err_msg => "Error deleting #{src.path}"
    )
    exit(rc.code) if rc.code != 0

    DriverLogger.log_info "Deleted #{src.path}"
rescue NetApp::Volume::VolumeMissing => e
    DriverLogger.log_info "Volume #{vol_name} for disk #{src.disk_id} missing " \
                                      "or already deleted: #{e.message}"
    exit 0
rescue StandardError => e
    if src.disk?
        DriverLogger.log_error "Error removing Disk #{src.disk_id} " \
                                           "Volume #{vol_name} " \
                                           "from VM #{arg_vmid}: #{e.message}"
    else
        DriverLogger.log_error 'Error removing directory for VM ID ' \
                                           "Volume #{vol_name} " \
                                           "#{arg_vmid}: #{e.message}"
    end
    exit(-1)
end
