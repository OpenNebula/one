require_relative '../lib/tm_action'
require_relative '../lib/datastore'
require_relative '../lib/netapp'

arg_src    = ARGV[0]
arg_dst    = ARGV[1]
arg_snapid = ARGV[2].to_i
arg_vmid   = ARGV[3].to_i
arg_dsid   = ARGV[4].to_i

cpds = TransferManager::Action.new(:vm_id => arg_vmid, :action_name => 'cpds')

src = TransferManager::Action::Location.new(arg_src)

dst_volume, dst_lun = arg_dst.split('/')[2..3]

# Retrieve destination (image) datastore information
netapp_ds = OpenNebula::Datastore.new_with_id(
    cpds.disk_attribute(src.disk_id, 'DATASTORE_ID').to_i, cpds.one
)
rc = netapp_ds.info(true)
raise rc.message.to_s if OpenNebula.is_error?(rc)

ds_hash = netapp_ds.to_hash['DATASTORE']['TEMPLATE']

host        = ds_hash['NETAPP_HOST']
user        = ds_hash['NETAPP_USER']
password    = ds_hash['NETAPP_PASS']
svm_uuid    = ds_hash['NETAPP_SVM']
target      = ds_hash['NETAPP_TARGET']
aggregates  = ds_hash['NETAPP_AGGREGATES']

netapp_suffix = ds_hash.key?('NETAPP_SUFFIX') ? "_#{ds_hash['NETAPP_SUFFIX']}" : ''

auth   = Base64.strict_encode64("#{user}:#{password}")
netapp = TransferManager::NetApp.new(auth, host, target, :action => cpds)

image_ds = OpenNebula::Datastore.new_with_id(arg_dsid, cpds.one)
rc = image_ds.info
raise rc.message.to_s if OpenNebula.is_error?(rc)

unless image_ds.to_hash['DATASTORE']['TEMPLATE']['NETAPP_HOST']
    raise 'Image datastore is not a NetApp datastore'
end

OpenNebula::DriverLogger.log_info "Saving VM disk #{src.disk_id} to #{src.path}"

svm = netapp.get_svm(svm_uuid, aggregates)

new_volume = nil

begin
    # Create the volume and LUN
    source_vol_name = "one_#{arg_vmid}_disk_#{src.disk_id}#{netapp_suffix}"

    source_volume = TransferManager::NetApp::Volume.new({ 'name' => source_vol_name }, netapp)

    snap_name   = 'one_tmp_copy_snap'
    source_snap = false
    if arg_snapid != -1
        snap_name = "one_snap_#{arg_snapid}"
        source_snap = source_volume.get_snapshots.find {|s| s['name'] == snap_name }
    else
        check_snap = source_volume.get_snapshots.find {|s| s['name'] == snap_name }
        if check_snap
            check_snap.delete
            OpenNebula::DriverLogger.log_info 'Deleted existing temporary snapshot for ' \
                                                "#{source_volume.name}"
        end

        source_snap = source_volume.create_snapshot({ 'name' => snap_name })
        OpenNebula::DriverLogger.log_info 'Created new temporary snapshot for ' \
                                            "#{source_volume.name}"
    end
    raise 'Unable to find or create source snapshot' unless source_snap

    new_volume_data= {
        'name' => dst_volume,
        'clone' => {
            'parent_volume'   => { 'uuid' => source_volume.uuid },
            'parent_snapshot' => { 'uuid' => source_snap.uuid },
            'is_flexclone'    => true
        }
    }
    new_volume = svm.clone_volume(new_volume_data).tap(&:fetch_data)
    new_lun    = new_volume.lun
    OpenNebula::DriverLogger.log_info "Cloned volume #{source_volume.name} " \
                                        "to #{new_volume.name}"

    unless new_lun
        OpenNebula::DriverLogger.log_error "No LUN found for cloned volume #{new_volume.uuid}"
        exit 1
    end

    new_lun.rename(dst_lun)
    OpenNebula::DriverLogger.log_info "Renamed LUN to #{new_lun.name}"

    new_volume.split_flexclone
    unless new_volume.watch_flexclone_split
        OpenNebula::DriverLogger.log_error "Unable to split flexclone volume #{new_volume.name}"
        exit 1
    end

    if snap_name == 'one_tmp_copy_snap'
        source_snap.delete
        OpenNebula::DriverLogger.log_info 'Deleted temporary snap from source volume ' \
                                          "#{source_volume.name}"
    end

    new_snap = new_volume.get_snapshots.find {|s| s['name'] == snap_name }
    new_snap.delete if new_snap
    OpenNebula::DriverLogger.log_info 'Deleted temporary snap from deployed volume ' \
                                        "#{new_volume.name}"
rescue StandardError => e
    OpenNebula::DriverLogger.log_error "Error cloning VM #{arg_vmid} disk #{src.disk_id} " \
                                       "to #{src.path}: #{e.message}"
    OpenNebula::DriverLogger.log_error e.backtrace
    if new_volume
        new_volume.delete
    end
    exit 1
end
