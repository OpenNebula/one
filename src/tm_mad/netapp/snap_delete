require_relative '../lib/tm_action'
require_relative '../lib/datastore'
require_relative '../lib/netapp'

arg_src    = ARGV[0]
arg_snapid = ARGV[1]
arg_vmid   = ARGV[2]
arg_dsid   = ARGV[3]

snap_delete = TransferManager::Action.new(:vm_id => arg_vmid, :action_name => 'snap_delete')

src = TransferManager::Action::Location.new(arg_src)

netapp_ds = OpenNebula::Datastore.new_with_id(arg_dsid, snap_delete.one)
rc = netapp_ds.info(true)
raise rc.message.to_s if OpenNebula.is_error?(rc)

ds_hash = netapp_ds.to_hash['DATASTORE']['TEMPLATE']

host     = ds_hash['NETAPP_HOST']
user     = ds_hash['NETAPP_USER']
password = ds_hash['NETAPP_PASS']

netapp_suffix = ds_hash.key?('NETAPP_SUFFIX') ? "_#{ds_hash['NETAPP_SUFFIX']}" : ''

auth = Base64.strict_encode64("#{user}:#{password}")
netapp = TransferManager::NetApp.new(auth, host, false, :action => snap_delete)

OpenNebula::DriverLogger.log_info "Deleting snapshot for Disk ID #{src.disk_id} " \
                                  "of VM ID #{arg_vmid}"

begin
    vol_name = "one_#{arg_vmid}_disk_#{src.disk_id}#{netapp_suffix}"
    volume   = TransferManager::NetApp::Volume.new({ 'name' => vol_name }, netapp)

    snapshot_name   = "one_snap_#{arg_snapid}"
    target_snapshot = volume.get_snapshots.find {|s| s.name == snapshot_name }

    target_snapshot.delete

    OpenNebula::DriverLogger.log_info "Deleted snapshot #{arg_snapid} for #{vol_name}"
rescue StandardError => e
    OpenNebula::DriverLogger.log_error "Error deleting snapshot #{arg_snapid} " \
                                       "for #{vol_name}: #{e.message}"
    exit 1
end

exit 0
