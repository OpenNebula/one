require_relative '../lib/tm_action'
require_relative '../lib/datastore'
require_relative '../lib/netapp'

_src_host = ARGV[0]
dst_host  = ARGV[1]
dst_dir   = ARGV[2]
vm_id     = ARGV[3]
dsid      = ARGV[4]

daction64 = STDIN.read

failmigrate = TransferManager::Action.new(:vm_id => vm_id, :action_name => 'failmigrate')

action = Base64.decode64(daction64)
xml = REXML::Document.new(action).root

begin
    netapp_data = OpenNebula::Datastore.new_with_id(dsid, failmigrate.one)
    rc = netapp_data.info(true)
    raise rc.message.to_s if OpenNebula.is_error?(rc)

    ds_hash = netapp_data.to_hash['DATASTORE']['TEMPLATE']

    host     = ds_hash['NETAPP_HOST']
    user     = ds_hash['NETAPP_USER']
    password = ds_hash['NETAPP_PASS']
    target   = ds_hash['NETAPP_TARGET']

    netapp_suffix = ds_hash.key?('NETAPP_SUFFIX') ? "_#{ds_hash['NETAPP_SUFFIX']}" : ''

    auth = Base64.strict_encode64("#{user}:#{password}")
    netapp = TransferManager::NetApp.new(auth, host, target, :action => failmigrate)
rescue StandardError => e
    OpenNebula::DriverLogger.log_error "Unable to establish connection with NetApp: #{e.message}"
    exit 1
end

OpenNebula::DriverLogger.log_info "Removing VM #{vm_id} Disk references from #{dst_host}"

begin
    # Process NetApp disks with hard failure on errors
    xml.elements.each('//DISK') do |disk|
        disk_id = disk.elements['DISK_ID'].text
        next unless disk.elements['TM_MAD'].text rescue nil == 'netapp'

        vol_name = "one_#{vm_id}_disk_#{disk_id}#{netapp_suffix}"

        volume = TransferManager::NetApp::Volume.new({ 'name' => vol_name }, netapp)
        # volume.fetch_data
        lun = volume.lun || raise("LUN not found for #{vol_name}")

        lun.lun_map.remove_connection(dst_host, :force => true)

        OpenNebula::DriverLogger.log_info "Cleaned up disk entry for VM #{vm_id}'s " \
                                          "Disk #{disk_id} from #{dst_host}"
    end

    failmigrate.ssh(
        :cmds => "rm -rf #{dst_dir}",
        :host => dst_host,
        :err_msg => "Error deleting #{dst_dir} on #{dst_host}"
    )
rescue StandardError => e
    OpenNebula::DriverLogger.log_error "Fatal failmigration error: #{e.message}"
    exit 1
end

exit 0
