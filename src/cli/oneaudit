#!/usr/bin/env python
# Command-line tool for querying audit logs.
import sys
import sqlite3
import argparse
import json
from datetime import datetime

def main():
    parser = argparse.ArgumentParser(description='OpenNebula Audit Log Viewer')
    parser.add_argument('--db', default='/var/lib/one/oneaudit.db', help='Path to audit database')
    parser.add_argument('--user', type=int, help='Filter by user ID')
    parser.add_argument('--method', help='Filter by method name')
    parser.add_argument('--resource-type', help='Filter by resource type (e.g., VM, HOST)')
    parser.add_argument('--resource-id', type=int, help='Filter by resource ID')
    parser.add_argument('--start', help='Start time (YYYY-MM-DDTHH:MM:SS)')
    parser.add_argument('--end', help='End time')
    parser.add_argument('--limit', type=int, default=100)
    parser.add_argument('--offset', type=int, default=0)
    parser.add_argument('--json', action='store_true', help='Output as JSON')
    args = parser.parse_args()

    conn = sqlite3.connect(args.db)
    cursor = conn.cursor()

    # Build query
    conditions = []
    params = []
    if args.user is not None:
        conditions.append('user_id = ?')
        params.append(args.user)
    if args.method:
        conditions.append('method = ?')
        params.append(args.method)
    if args.resource_type:
        conditions.append('resource_type = ?')
        params.append(args.resource_type)
    if args.resource_id is not None:
        conditions.append('resource_id = ?')
        params.append(args.resource_id)
    if args.start:
        start_ts = int(datetime.strptime(args.start, '%Y-%m-%dT%H:%M:%S').timestamp())
        conditions.append('timestamp >= ?')
        params.append(start_ts)
    if args.end:
        end_ts = int(datetime.strptime(args.end, '%Y-%m-%dT%H:%M:%S').timestamp())
        conditions.append('timestamp <= ?')
        params.append(end_ts)

    where = ' AND '.join(conditions) if conditions else '1=1'
    sql = f'SELECT * FROM audit_log WHERE {where} ORDER BY timestamp DESC LIMIT ? OFFSET ?'
    params.extend([args.limit, args.offset])
    cursor.execute(sql, params)
    rows = cursor.fetchall()

    if args.json:
        entries = []
        for row in rows:
            entry = {
                'id': row[0],
                'user_id': row[1],
                'group_id': row[2],
                'request_id': row[3],
                'method': row[4],
                'arguments': json.loads(row[5]),
                'result': json.loads(row[6]),
                'remote_ip': row[7],
                'timestamp': row[8],
                'resource_type': row[9],
                'resource_id': row[10],
                'success': bool(row[11])
            }
            entries.append(entry)
        print(json.dumps(entries, indent=2))
    else:
        # Tabular output
        print('{:5} {:6} {:10} {:20} {:10}'.format('ID', 'User', 'Method', 'Resource', 'Success'))
        for row in rows:
            print('{:5} {:6} {:10} {:20} {:10}'.format(row[0], row[1], row[4], f'{row[9]}#{row[10]}', 'Yes' if row[11] else 'No'))

    conn.close()

if __name__ == '__main__':
    main()
