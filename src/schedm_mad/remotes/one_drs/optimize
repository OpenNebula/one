import sys

sys.path.insert(
    0,
    "/usr/lib/one/python/",
)
import base64
from datetime import datetime
import time

from lib import OptimizerParser, OptimizerSerializer


def main():
    # Read from standard input
    stdin_data = sys.stdin.read()
    decoded_data = base64.b64decode(stdin_data)

    # Parse XML input and build Optimizer
    parser = OptimizerParser(stdin_data=decoded_data, mode="optimize")
    if parser.check_vm_states():
        sys.exit(1)
    debug = parser.debug
    cluster_id = parser.cluster_id
    msg = f"Optimization of cluster {cluster_id}: parsing --"
    try:
        optimizer = parser.build_optimizer()
        if debug:
            sys.stderr.write(f"INFO: {msg} SUCCESS\n")
    except Exception as exc:
        sys.stderr.write(f"ERROR: {msg} {exc}\n")
        sys.exit(1)

    # Execute Optimizer
    msg = f"Optimization of cluster {cluster_id}: mapping --"
    start_time = time.time()
    elapsed = -1
    try:
        optimizer.map()
        elapsed = time.time() - start_time
        placement = optimizer._opt_placement
        if debug:
            sys.stderr.write(f"INFO: {msg} SUCCESS\n")
    except Exception as exc:
        sys.stderr.write(f"ERROR: {msg} {exc}\n")
        sys.exit(1)
    if debug:
        try:
            # Write the optimizer report.
            with open("/tmp/onedrs_report.txt", mode="w") as file:
                out = optimizer.report()
                file.write(f"{datetime.now()}\n\n{out}\n")
        except Exception as exc:
            sys.stderr.write(f"ERROR: Writing onedrs_report.txt -- {exc}\n")
        try:
            # Write the allocations.
            with open("/tmp/onedrs_allocs.txt", mode="w") as file:
                out = "\n".join(str(val) for val in placement.values())
                file.write(f"{datetime.now()}\n\n{out}\n")
        except Exception as exc:
            sys.stderr.write(f"ERROR: Writing onedrs_allocs.txt -- {exc}\n")

    # Serialize Optimizer response
    msg = f"Optimization of cluster {cluster_id}: serializing --"
    try:
        serializer = OptimizerSerializer(parser.plan_id)
        scheduler_output, logs = serializer.build_optimizer_output(
            curr_placement=optimizer._curr_placement,
            opt_placement=placement
        )
        xml_output = serializer.render(scheduler_output)
        sys.stdout.write(xml_output)
        if debug:
            sys.stderr.write(f"INFO: {msg} SUCCESS\n")
    except Exception as exc:
        sys.stderr.write(f"ERROR: {msg} {exc}\n")
        sys.exit(1)
    if debug:
        try:
            # Write the output.
            with open("/tmp/onedrs_output.txt", mode="w") as file:
                file.write(f"{datetime.now()}\n\nOutput:\n\n{xml_output}\n")
        except Exception as exc:
            sys.stderr.write(f"ERROR: Writing onedrs_output.txt -- {exc}\n")

    # VM log messages
    for vm_id, level, message in logs:
        parser.log_vm(level, vm_id, message)

    # General log message
    # TODO: Take the optimizer status from its model.
    status = optimizer.report().splitlines()[1].strip().upper()
    if status == "ERROR" or status == "INFEASIBLE":
        parser.log_general("ERROR", "Unable to find optimal solution")
        sys.exit(1)
    else:
        parser.log_general("INFO", f"Optimization problem solved in {int(elapsed)}s")

    sys.exit(0)


if __name__ == "__main__":
    main()
