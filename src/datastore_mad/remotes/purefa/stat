require 'tmpdir'

require_relative '../../tm/lib/tm_action'
require_relative '../../tm/lib/netapp'

include TransferManager

# Fetch arguments
daction64  = STDIN.read
request_id = ARGV[0]

begin
    action = Base64.decode64(daction64)
    xml = REXML::Document.new(action).root

    # Extract only the fields required
    img_path = xml.elements['IMAGE/PATH'].text
    if !img_path.start_with?('purefa://')
        # call the fs based one
        stat_cmd = "echo '#{daction64}' | #{File.dirname(__FILE__)}/../fs/stat #{request_id}"
        fs_check = Action.ssh('stat', {
                                  :cmds => stat_cmd,
                                  :host => nil,
                                  :err_msg => 'Error getting image size',
                                  :nostdout => false
                              })
        puts fs_check.stdout
        exit(fs_check.code)
    end

    image_src = xml.elements['IMAGE/SOURCE'].txt

    purefa_host    = xml.elements['DATASTORE/TEMPLATE/PUREFA_HOST'].text
    purefa_token   = xml.elements['DATASTORE/TEMPLATE/PUREFA_API_TOKEN'].text
    purefa_version = xml.elements['DATASTORE/TEMPLATE/PUREFA_VERSION']
    purefa_version = purefa_version.nil? ? PureFA::DEFAULT_API_VERSION : purefa_version.text

    raise 'Missing required datastore attributes' unless image_src
rescue StandardError => e
    STDERR.puts "Error parsing DS_DRIVER_ACTION_DATA: #{e.message}"
    exit(-1)
end

stat = Action.new(:action_name => 'stat')

purefa = PureFA.new(
    :host => purefa_host,
    :api_token => purefa_token,
    :action => stat,
    :target => nil,
    :api_version => purefa_version
)

vol = purefa.get_volume(image_src)

puts "#{vol['space']['total_provisioned'].to_i/1024/1024.round}\n"
