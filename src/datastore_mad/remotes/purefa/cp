require 'digest'
require 'socket'
require 'tmpdir'

require_relative '../../tm/lib/tm_action'
require_relative '../../tm/lib/purefa'

include TransferManager
include OpenNebula

def get_image_format(src_path)
    info_command = "qemu-img info --output=json #{src_path}"
    rc = Action.ssh(:cmds => info_command)
    rc.code != 0 ? nil : JSON.parse(rc.stdout)['format']
end

# Fetch arguments
daction64  = STDIN.read
request_id = ARGV[0]

begin
    # Decode action
    daction = Base64.decode64(daction64)
    xml = REXML::Document.new(daction).root

    ds_id = xml.elements['DATASTORE/ID'].text.to_i
    src_path = xml.elements['IMAGE/PATH'].text
    src_size = "#{xml.elements['IMAGE/SIZE'].text.to_i}M"

    purefa_host    = xml.elements['DATASTORE/TEMPLATE/PUREFA_HOST'].text
    purefa_token   = xml.elements['DATASTORE/TEMPLATE/PUREFA_API_TOKEN'].text
    purefa_target  = xml.elements['DATASTORE/TEMPLATE/PUREFA_TARGET'].text
    purefa_version = xml.elements['DATASTORE/TEMPLATE/PUREFA_VERSION']
    purefa_version = purefa_version.nil? ? PureFA::DEFAULT_API_VERSION : purefa_version.text

    purefa_suffix = xml.elements['DATASTORE/TEMPLATE/PUREFA_SUFFIX']
    purefa_suffix = purefa_suffix.nil? ? '' : "_#{purefa_suffix.text}"
rescue StandardError => e
    STDERR.puts "Error parsing DS_DRIVER_ACTION_DATA: #{e.message}"
    exit(-1)
end

cp = Action.new(:action_name => 'cp')

purefa = PureFA.new(
    :host => purefa_host,
    :target => purefa_target,
    :action => cp,
    :api_token => purefa_token,
    :api_version => purefa_version
)

downloader_command = "#{File.dirname(__FILE__)}/../downloader.sh"
volume_name = "one_#{ds_id}_#{request_id}#{purefa_suffix}"
fe_hostname = Socket.gethostname

begin
    vol = purefa.create_volume(:name => volume_name, :size => src_size)
    DriverLogger.log_info "Created volume #{vol.name}"
rescue StandardError => e
    DriverLogger.log_error "Failed to create volume #{volume_name}: #{e.message}"
    exit(-1)
end

cxn_created = false
begin
    cxn = vol.create_connection(fe_hostname)
    DriverLogger.log_info "Created connection for #{vol.name} to host #{fe_hostname}"
    cxn_created = true

    device = cxn.setup_disk
    device_mapped = true

    DriverLogger.log_info "Setup device #{device} for volume #{vol.name}"
rescue StandardError => e
    DriverLogger.log_error "Failed to create connection for #{vol.name} " \
                           "to host #{fe_hostname}: #{e.message}"
    DriverLogger.log_error e.backtrace.to_s
    cxn.remove_connection if device_mapped
    cxn.delete if cxn_created
    vol.destroy
    vol.delete
    exit(-1)
end

begin
    Dir.mktmpdir do |tmp_dir|
        realpath_command = "readlink -f #{device}"
        rc = cp.ssh({
                        :cmds => realpath_command,
                        :host => false,
                        :nostdout => false,
                        :nostderr => false
                    })
        raise "Realpath STDERR: #{rc.stderr}" if rc.code != 0

        real_device_path = rc.stdout.strip
        temp_file        = File.join(tmp_dir, "temp_image_#{volume_name}.qcow2")
        download_command = "#{downloader_command} #{src_path} #{temp_file}"
        rc = cp.ssh({
                        :cmds => "DRV_ACTION='#{daction64}' #{download_command}",
                        :host => false,
                        :err_msg => "Failed to download #{src_path} to #{temp_file}",
                        :nostderr => false
                    })
        raise "Downloader STDERR: #{rc.stderr}" if rc.code != 0

        DriverLogger.log_info "Downloaded #{src_path} to #{temp_file}"

        convert_command = "qemu-img convert -O raw #{temp_file} #{real_device_path}"
        rc = cp.ssh({
                        :cmds => convert_command,
                        :host => false,
                        :err_msg => "Failed to convert #{temp_file} to #{device}",
                        :nostderr => false
                    })

        raise "Converter STDERR: #{rc.stderr}" if rc.code != 0

        cxn.flush_device_io(false, real_device_path)
        DriverLogger.log_info "Copied #{src_path} to #{device}"
    end

    puts "#{volume_name} raw"
rescue StandardError => e
    DriverLogger.log_error "Failed to setup device and data for volume #{vol}: #{e.message}"
    cxn.remove_connection
    cxn.delete

    vol.destroy
    vol.delete
    DriverLogger.log_error "Cleaned up volume #{vol}"
    raise
end

cxn.remove_connection
cxn.delete

exit 0
