require_relative '../../tm/lib/tm_action'
require_relative '../../tm/lib/purefa'

include TransferManager
include OpenNebula

daction64 = STDIN.read
image_id  = ARGV[0]

begin
    action = Base64.decode64(daction64)
    xml = REXML::Document.new(action).root

    img_source  = xml.elements['IMAGE/SOURCE'].text
    snap_id     = xml.elements['IMAGE/TARGET_SNAPSHOT'].text.to_i

    purefa_host    = xml.elements['DATASTORE/TEMPLATE/PUREFA_HOST'].text
    purefa_token   = xml.elements['DATASTORE/TEMPLATE/PUREFA_API_TOKEN'].text

    purefa_version = xml.elements['DATASTORE/TEMPLATE/PUREFA_VERSION']
    purefa_version = purefa_version.nil? ? PureFA::DEFAULT_API_VERSION : purefa_version.text

    snap_revert = Action.new(:action_name => 'snap_revert')

    purefa = PureFA.new(
        :host      => purefa_host,
        :api_token => purefa_token,
        :target    => nil,
        :action    => snap_revert,
        :version   => purefa_version
    )

    img_vol = purefa.get_volume(img_source)
    target_snap = img_vol.get_snapshot(snap_id)
    _img_vol = target_snap.restore

    DriverLogger.log_info "Image #{image_id} restored to snapshot ID #{snap_id}"
rescue StandardError => e
    DriverLogger.log_error "Error restoring image #{image_id} to snap ID #{snap_id}: #{e.message}"
    exit(-1)
end
