require_relative '../../tm/lib/tm_action'
require_relative '../../tm/lib/datastore'
require_relative '../../tm/lib/purefa'

include TransferManager
include OpenNebula

daction64 = STDIN.read
_image_id = ARGV[0]

action = Base64.decode64(daction64)
xml = REXML::Document.new(action).root

ds_id  = xml.elements['DATASTORE/ID'].text.to_i
img_id = xml.elements['IMAGE/ID'].text.to_i

purefa_ds = Datastore.new_with_id(ds_id, Client.new)
rc = purefa_ds.info(true)
raise rc.message.to_s if OpenNebula.is_error?(rc)

ds_hash = purefa_ds.to_hash['DATASTORE']['TEMPLATE']

purefa_host    = ds_hash['PUREFA_HOST']
purefa_token   = ds_hash['PUREFA_API_TOKEN']
purefa_target  = ds_hash['PUREFA_TARGET']
purefa_version = ds_hash.key?('PUREFA_VERSION') ? ds_hash['PUREFA_VERSION'] : PureFA::DEFAULT_API_VERSION
purefa_suffix  = ds_hash.key?('PUREFA_SUFFIX') ? "_#{ds_hash['PUREFA_SUFFIX']}" : ''

purefa = PureFA.new(
    :host => purefa_host,
    :target => purefa_target,
    :api_token => purefa_token,
    :api_version => purefa_version,
    :action => false
)

volume_name = "one_#{ds_id}_#{img_id}#{purefa_suffix}"
volume = purefa.get_volume(volume_name)

size_mb = volume['space']['total_provisioned'].to_i/1024/1024.round

output_xml  = '<IMPORT_INFO>'
output_xml << "<IMPORT_SOURCE><![CDATA[purefa://#{volume_name}]]></IMPORT_SOURCE>"
output_xml << '<DISPOSE>NO</DISPOSE>'
output_xml << '<FORMAT><![CDATA[RAW]]></FORMAT>'
output_xml << '<MD5><![CDATA[NA]]></MD5>'
output_xml << "<SIZE><![CDATA[#{size_mb}]]></SIZE>"
output_xml << '</IMPORT_INFO>'

puts output_xml
