require 'digest'
require 'socket'

require_relative '../../tm/lib/tm_action'
require_relative '../../tm/lib/datastore'
require_relative '../../tm/lib/purefa'

include TransferManager
include OpenNebula

# Fetch arguments
daction64 = STDIN.read
arg_imgid = ARGV[0]

TransferManager::Datastore.load_env

begin
    action = Base64.decode64(daction64)
    xml = REXML::Document.new(action).root

    ds_id      = xml.elements['DATASTORE/ID'].text.to_i
    img_format = xml.elements['IMAGE/FORMAT'].text
    img_size   = "#{xml.elements['IMAGE/SIZE'].text.to_i}M"
    img_fs     = xml.elements['IMAGE/FS'].text
    if !img_fs.empty? && img_fs != '-' && !ENV['SUPPORTED_FS'].split(',').include?(img_fs)
        raise 'Unsupported filesystem'
    end

    purefa_host    = xml.elements['DATASTORE/TEMPLATE/PUREFA_HOST'].text
    purefa_token   = xml.elements['DATASTORE/TEMPLATE/PUREFA_API_TOKEN'].text
    purefa_target  = xml.elements['DATASTORE/TEMPLATE/PUREFA_TARGET'].text
    purefa_version = xml.elements['DATASTORE/TEMPLATE/PUREFA_VERSION']
    purefa_version = purefa_version.nil? ? PureFA::DEFAULT_API_VERSION : purefa_version.text

    purefa_suffix = xml.elements['DATASTORE/TEMPLATE/PUREFA_SUFFIX']
    purefa_suffix = purefa_suffix.nil? ? '' : "_#{purefa_suffix.text}"
rescue StandardError => e
    STDERR.puts "Error parsing DS_DRIVER_ACTION_DATA: #{e.message}"
    exit(-1)
end

volume_name = "one_#{ds_id}_#{arg_imgid}#{purefa_suffix}"
fe_hostname = Socket.gethostname

if img_format == 'save_as'
    puts volume_name
    exit(0)
end

mkfs = Action.new(:action_name => 'mkfs')

purefa = PureFA.new(
    :host        => purefa_host,
    :api_token   => purefa_token,
    :action      => mkfs,
    :target      => purefa_target,
    :api_version => purefa_version
)

volume = purefa.create_volume(:name => volume_name, :size => img_size)
DriverLogger.log_info "Created volume #{volume.name}"

unless img_fs.empty?
    cxn = volume.create_connection(fe_hostname)
    device_path = cxn.setup_disk
    DriverLogger.log_info "Setup device #{device_path} for volume #{volume.name}"
    fs_opts = ENV.fetch("FS_OPTS_#{img_fs}", '')

    mkfs_cmd = volume.mkfs_command(device_path, img_fs, fs_opts)

    rc = mkfs.ssh({
                      :cmds => mkfs_cmd,
                      :host => false,
                      :nostderr => false,
                      :err_msg => "Failed to create file system with command #{mkfs_cmd}"
                  })
    exit(rc.code) if rc.code != 0

    DriverLogger.log_info "File system #{img_fs} created on #{device_path}"

    cxn.remove_connection(false)
    cxn.delete

    DriverLogger.log_info 'Cleaned up device connection'
end

puts volume_name

exit 0
