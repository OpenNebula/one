require_relative '../../tm/lib/tm_action'
require_relative '../../tm/lib/netapp'

daction64 = STDIN.read
image_id =  ARGV[0]

begin
    action = Base64.decode64(daction64)
    xml = REXML::Document.new(action).root

    img_source  = xml.elements['IMAGE/SOURCE'].text
    snap_id     = xml.elements['IMAGE/TARGET_SNAPSHOT'].text.to_i

    netapp_host = xml.elements['DATASTORE/TEMPLATE/NETAPP_HOST'].text
    netapp_user = xml.elements['DATASTORE/TEMPLATE/NETAPP_USER'].text
    netapp_pass = xml.elements['DATASTORE/TEMPLATE/NETAPP_PASS'].text

    snap_flatten = TransferManager::Action.new(:action_name => 'snap_flatten')

    auth   = Base64.strict_encode64("#{netapp_user}:#{netapp_pass}")
    netapp = TransferManager::NetApp.new(auth, netapp_host, false, :action => snap_flatten)

    img_vol = TransferManager::NetApp::Volume.new({ 'name' => img_source.split('/')[2] }, netapp)

    all_snaps   = img_vol.get_snapshots
    target_snap = all_snaps.find {|snap| snap.name == "one_snap_#{snap_id}" }

    img_vol.restore_snapshot(:uuid => target_snap.uuid)

    OpenNebula::DriverLogger.log_info "Image #{image_id} restored to snapshot ID #{snap_id}"
rescue StandardError => e
    STDERR.puts "Error restoring image #{image_id} to snapshot ID #{snap_id}: #{e.message}"
end

begin
    all_snaps = img_vol.get_snapshots
    all_snaps.each {|snap| snap.delete }
    OpenNebula::DriverLogger.log_info "Removed snapshots for Image #{image_id}"
rescue StandardError => e
    STDERR.puts "Error removing snapshots for Image #{image_id}: #{e.message}"
    exit(-1)
end
