require 'tmpdir'

require_relative '../../tm/lib/tm_action'
require_relative '../../tm/lib/netapp'
require_relative '../../tm/lib/datastore'

# Fetch arguments
daction64 = STDIN.read
image_id  = ARGV[0]

begin
    action = Base64.decode64(daction64)
    xml = REXML::Document.new(action).root

    # Extract only the fields required for the NetApp operation
    ds_id = xml.elements['DATASTORE/ID'].text.to_i
    base_path = xml.elements['DATASTORE/BASE_PATH'].text
    src_path = xml.elements['IMAGE/PATH'].text

    netapp_ds = OpenNebula::Datastore.new_with_id(ds_id, OpenNebula::Client.new)
    rc = netapp_ds.info(true)
    raise rc.message.to_s if OpenNebula.is_error?(rc)

    ds_hash = netapp_ds.to_hash['DATASTORE']['TEMPLATE']

    netapp_host       = ds_hash['NETAPP_HOST']
    netapp_user       = ds_hash['NETAPP_USER']
    netapp_pass       = ds_hash['NETAPP_PASS']
    netapp_svm        = ds_hash['NETAPP_SVM']
    netapp_target     = ds_hash['NETAPP_TARGET']
    netapp_aggregates = ds_hash['NETAPP_AGGREGATES']
    netapp_suffix     = ds_hash.key?('NETAPP_SUFFIX') ? "_#{ds_hash['NETAPP_SUFFIX']}" : ''

    netapp_reserve = if ds_hash.key?('NETAPP_RESERVE')
                         ds_hash['NETAPP_RESERVE'].to_i
                     else
                         TransferManager::NetApp::Volume::DEFAULT_SNAPSHOT_RESERVE
                     end

    grow_threshold = if ds_hash.key?('NETAPP_GROW_THRESHOLD')
                         ds_hash['NETAPP_GROW_THRESHOLD'].to_i
                     else
                         TransferManager::NetApp::Volume::DEFAULT_GROW_THRESHOLD
                     end

    grow_ratio     = if ds_hash.key?('NETAPP_GROW_RATIO')
                         ds_hash['NETAPP_GROW_RATIO'].to_f
                     else
                         TransferManager::NetApp::Volume::DEFAULT_GROW_RATIO
                     end
    always_copy    = ds_hash.key?('NETAPP_ALWAYS_COPY') &&
                     ds_hash['NETAPP_ALWAYS_COPY'].upcase == 'YES'

    mode = always_copy ? :copy : :independent

    raise 'Missing required datastore attributes' unless ds_id && base_path && src_path
rescue StandardError => e
    STDERR.puts "Error parsing DS_DRIVER_ACTION_DATA: #{e.message}"
    exit(-1)
end

clone = TransferManager::Action.new(:action_name => 'clone')
netapp_auth = Base64.strict_encode64("#{netapp_user}:#{netapp_pass}")
netapp = TransferManager::NetApp.new(netapp_auth, netapp_host, netapp_target, :action => clone)
svm = netapp.get_svm(netapp_svm, netapp_aggregates)

new_volume_name = "one_#{ds_id}_#{image_id}#{netapp_suffix}"
new_lun_name = "one_#{ds_id}_#{image_id}#{netapp_suffix}_lun"

begin
    source_vol_name = src_path.split('/')[2] # one-123-456

    source_volume = TransferManager::NetApp::Volume.new({ 'name' => source_vol_name }, netapp)
    # source_volume.fetch_data
    source_vol_snapshots  = source_volume.get_snapshots
    source_vol_goldensnap = source_vol_snapshots.find {|s| s['name'] == TransferManager::NetApp::GOLDENSNAP_NAME }

    unless source_vol_goldensnap
        OpenNebula::DriverLogger.log_info "Creating goldensnap for volume #{source_volume.uuid}"
        goldsnap_data = {
            'name'    => TransferManager::NetApp::GOLDENSNAP_NAME,
            'comment' => 'Golden Snapshot created by OpenNebula'
        }
        source_vol_goldensnap = source_volume.create_snapshot(goldsnap_data)

        unless source_vol_goldensnap
            raise "Failed to create golden snapshot on #{source_volume.name}"
        end
    end

    adjusted_size = (source_volume['size'].to_i * (1 + netapp_reserve / 100.0)).ceil
    extra_payload = {
        'autosize' => {
            'grow_threshold' => grow_threshold,
            'maximum'        => "#{adjusted_size * grow_ratio}MB",
            'minimum'        => "#{adjusted_size}MB",
            'mode'           => 'grow_shrink'
        }
    }

    new_volume = svm.provision_disk_volume(
        source_vol_goldensnap, new_volume_name, new_lun_name,
        :mode => mode, :extra_payload => extra_payload
    )
    new_lun = new_volume.lun

    OpenNebula::DriverLogger.log_info "Cloned volume #{source_volume.name} to #{new_volume.name}"

    unless new_lun
        OpenNebula::DriverLogger.log_error "No LUN found for cloned volume #{new_volume.uuid}"
        exit 1
    end

    OpenNebula::DriverLogger.log_info "LUN ready at #{new_lun.name}"

    puts new_lun.name
rescue StandardError => e
    OpenNebula::DriverLogger.log_info "Error cloning #{src_path} to #{new_lun_name}: #{e.message}"
    if new_volume
        new_volume.delete
    end
    exit 1
end
