[Unit]
Description=OpenNebula oVirt API Service
After=syslog.target network-online.target
Wants=network-online.target

[Service]
Type=simple
Group=oneadmin
User=oneadmin
Environment=GEM_PATH=/usr/share/one/gems
Environment=GEM_HOME=/usr/share/one/gems
WorkingDirectory=/usr/lib/one/ovirtapi-server
ExecStartPre=+/usr/lib/one/ovirtapi-server/scripts/init_clean.rb
ExecStart=/usr/share/one/gems/bin/puma -C /etc/one/ovirtapi-puma.rb
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StartLimitInterval=60
StartLimitBurst=3
Restart=on-failure
RestartSec=5
SyslogIdentifier=opennebula-ovirtapi

[Install]
WantedBy=multi-user.target
