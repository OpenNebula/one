<suppressions>
    <!-- The string is lowercased in place. -->
    <suppress>
        <id>ignoredReturnValue</id>
        <fileName>*.*</fileName>
        <symbolName>one_util::tolower</symbolName>
    </suppress>
    <!-- Callback parameters must match the required callback signatures. -->
    <suppress>
        <id>constParameterCallback</id>
        <fileName>*.*</fileName>
    </suppress>
    <!-- Older versions may skip a diagnostic above.
         Cppcheck matches the configured file pattern exactly for unmatched suppressions. -->
    <suppress>
        <id>unmatchedSuppression</id>
        <fileName>*.*</fileName>
    </suppress>
    <!-- Global suppression, issues which we don't want to solve -->
	<suppress>
		<id>variableScope</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>noExplicitConstructor</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>danglingLifetime</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>shadowFunction</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>constParameterPointer</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>constParameterReference</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>constVariablePointer</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>constVariableReference</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>useStlAlgorithm</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>missingInclude</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>missingIncludeSystem</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>duplInheritedMember</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>checkersReport</id>
		<fileName>*</fileName>
	</suppress>
	<suppress>
		<id>cstyleCast</id>
		<fileName>*</fileName>
	</suppress>
	<!-- Suppresions specific per file, false positives -->
	<suppress>
		<id>knownConditionTrueFalse</id>
